<Project Sdk="Microsoft.NET.Sdk">

  <!-- NX-neutral intermediate representation (IR). Zero NXOpen dependency so the
       translator and its tests run on any runner. netstandard2.0 lets the same
       assembly load under .NET Framework (older NX) and modern .NET (NX 24xx+). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Oblikovati.Exporter.NX.Model</RootNamespace>
    <AssemblyName>Oblikovati.Exporter.NX.Model</AssemblyName>
  </PropertyGroup>

</Project>
