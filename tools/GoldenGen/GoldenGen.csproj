<Project Sdk="Microsoft.NET.Sdk">

  <!-- Emits representative .opd/.oad golden files from the translator+writer so CI
       Job 2 can open them with the real oblikovati-cli (binds the C# emitter to the
       Go reader, catching schema drift). Pass the output directory as the argument. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <RootNamespace>Oblikovati.Exporter.NX.GoldenGen</RootNamespace>
    <AssemblyName>GoldenGen</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Exporter.NX.Model\Exporter.NX.Model.csproj" />
    <ProjectReference Include="..\..\src\Exporter.NX.Recipe\Exporter.NX.Recipe.csproj" />
    <ProjectReference Include="..\..\src\Exporter.NX.Translate\Exporter.NX.Translate.csproj" />
    <ProjectReference Include="..\Fixtures\Exporter.NX.Fixtures.csproj" />
  </ItemGroup>

</Project>
